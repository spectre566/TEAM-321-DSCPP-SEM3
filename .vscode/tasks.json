{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "windows": {
                "args": [
                    "-S",
                    ".",
                    "-B",
                    "build",
                    "-G",
                    "MinGW Makefiles",
                    "-DCMAKE_BUILD_TYPE=Release"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "-j",
                "8"
            ],
            "dependsOn": "CMake: configure",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build",
                "--output-on-failure"
            ],
            "dependsOn": "CMake: build",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Run game",
            "type": "shell",
            "command": "${workspaceFolder}/build/SmartTrafficFlow",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "dependsOn": "CMake: build",
            "problemMatcher": []
        },
        {
            "label": "Benchmark (10 min, rush hour)",
            "type": "shell",
            "command": "${workspaceFolder}/build/SmartTrafficFlow",
            "args": [
                "--bench",
                "600",
                "--demand",
                "2"
            ],
            "dependsOn": "CMake: build",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}